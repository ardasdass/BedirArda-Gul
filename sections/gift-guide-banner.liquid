{{ 'gift-guide-banner.css' | asset_url | stylesheet_tag }}

<section
  class="gift-guide-banner"
  aria-label="{{ section.settings.banner_title | escape }}"
>
  <div class="gift-guide-banner__canvas">
    <header class="gift-guide-banner__header">
    <button class="gift-guide-banner__menu" type="button" aria-label="Menu">
      <svg width="24" height="18" viewBox="0 0 24 18" aria-hidden="true" focusable="false">
        <path d="M1 1h22M1 9h22M1 17h22" stroke="currentColor" stroke-width="2" />
      </svg>
    </button>
    <p class="gift-guide-banner__brand">{{ section.settings.store_name | escape }}</p>
    <p class="gift-guide-banner__tagline">{{ section.settings.catchphrase | escape }}</p>
    {%- if section.settings.header_button_label != blank -%}
      <a class="gift-guide-button" href="{{ section.settings.header_button_link }}">
        <span>{{ section.settings.header_button_label | escape }}</span>
        <svg class="gift-guide-button__arrow" viewBox="0 0 28 14" aria-hidden="true" focusable="false">
          <path d="M0 7h25M19 1l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.5" />
        </svg>
      </a>
    {%- endif -%}
    </header>

    <div class="gift-guide-banner__hero">
      <div class="gift-guide-banner__illustration" aria-hidden="true">
        <img src="{{ 'gift-guide-illustration-desktop.svg' | asset_url }}" alt="" width="1052" height="400">
      </div>
      <div class="gift-guide-banner__content">
      {%- if section.settings.banner_title != blank -%}
        <h1 class="gift-guide-banner__title">{{ section.settings.banner_title | escape }}</h1>
      {%- endif -%}
      {%- if section.settings.banner_description != blank -%}
        <div class="gift-guide-banner__description">{{ section.settings.banner_description }}</div>
      {%- endif -%}
      {%- if section.settings.banner_button_label != blank -%}
        <a class="gift-guide-button" href="{{ section.settings.banner_button_link }}">
          <span>{{ section.settings.banner_button_label | escape }}</span>
          <svg class="gift-guide-button__arrow" viewBox="0 0 28 14" aria-hidden="true" focusable="false">
            <path d="M0 7h25M19 1l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.5" />
          </svg>
        </a>
      {%- endif -%}
      </div>
    </div>

    {%- if section.settings.footer_text != blank -%}
      <p class="gift-guide-banner__footer">{{ section.settings.footer_text | escape }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Gift guide banner",
  "tag": "section",
  "class": "section-gift-guide-banner",
  "settings": [
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "text",
      "id": "store_name",
      "label": "Store name",
      "default": "TISSO VISION"
    },
    {
      "type": "text",
      "id": "catchphrase",
      "label": "Catchphrase",
      "default": "Find the ideal gift for your loved ones."
    },
    {
      "type": "text",
      "id": "header_button_label",
      "label": "Button label",
      "default": "CHOOSE GIFT"
    },
    {
      "type": "url",
      "id": "header_button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Banner"
    },
    {
      "type": "text",
      "id": "banner_title",
      "label": "Title",
      "default": "The Gift Guide"
    },
    {
      "type": "richtext",
      "id": "banner_description",
      "label": "Description",
      "default": "<p>Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season.</p>"
    },
    {
      "type": "text",
      "id": "banner_button_label",
      "label": "Button label",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "banner_button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "footer_text",
      "label": "Footer text",
      "default": "Sustainable, ethically made activewear"
    }
  ],
  "presets": [
    {
      "name": "Gift guide banner"
    }
  ]
}
{% endschema %}
