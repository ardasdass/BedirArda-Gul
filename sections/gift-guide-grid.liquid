{{ 'gift-guide-grid.css' | asset_url | stylesheet_tag }}
{{ 'gift-guide-popup.css' | asset_url | stylesheet_tag }}
<script src="{{ 'gift-guide-grid.js' | asset_url }}" defer="defer"></script>

<gift-guide-grid class="gift-guide-grid" data-section-id="{{ section.id }}">
  <div class="gift-guide-grid__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="gift-guide-grid__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    <div class="gift-guide-grid__list" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign grid_product = block.settings.product
          assign grid_image = block.settings.image
          if grid_image == blank and grid_product != blank
            assign grid_image = grid_product.featured_media
          endif
        -%}
        <div class="gift-guide-grid__item" role="listitem" {{ block.shopify_attributes }}>
          {%- if grid_image != blank -%}
            <img
              class="gift-guide-grid__image"
              srcset="{{ grid_image | image_url: width: 433 }} 433w, {{ grid_image | image_url: width: 866 }} 866w"
              src="{{ grid_image | image_url: width: 433 }}"
              sizes="(min-width: 750px) 433px, 169px"
              alt="{{ grid_image.alt | default: grid_product.title | escape }}"
              loading="lazy"
              width="{{ grid_image.width }}"
              height="{{ grid_image.height }}"
            >
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'gift-guide-grid__image gift-guide-grid__image--placeholder' }}
          {%- endif -%}

          {%- if grid_product != blank -%}
            <button
              type="button"
              class="gift-guide-grid__hotspot"
              style="--hotspot-x: {{ block.settings.hotspot_x }}%; --hotspot-y: {{ block.settings.hotspot_y }}%;"
              aria-label="{{ grid_product.title | escape }}"
              data-gift-guide-hotspot
              data-popup-id="GiftGuidePopup-{{ section.id }}-{{ forloop.index }}"
            >
              <span class="gift-guide-grid__hotspot-icon" aria-hidden="true"></span>
            </button>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>

  {%- for block in section.blocks -%}
    {%- if block.settings.product != blank -%}
      {%- assign popup_id = 'GiftGuidePopup-' | append: section.id | append: '-' | append: forloop.index -%}
      {%- render 'gift-guide-product-popup', product: block.settings.product, popup_id: popup_id -%}
    {%- endif -%}
  {%- endfor -%}

  {%- if section.settings.bundle_product != blank -%}
    {%- assign bundle_variant = section.settings.bundle_product.selected_or_first_available_variant -%}
    {%- if bundle_variant != blank -%}
      <script>
        window.giftGuideBundleRule = {
          variantId: {{ bundle_variant.id | json }},
          triggerOptions: [
            {{ section.settings.bundle_trigger_value_1 | json }},
            {{ section.settings.bundle_trigger_value_2 | json }}
          ]
        };
      </script>
    {%- endif -%}
  {%- endif -%}
</gift-guide-grid>

{% schema %}
{
  "name": "Gift guide grid",
  "tag": "section",
  "class": "section-gift-guide-grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Time-worn in the wild"
    },
    {
      "type": "header",
      "content": "Bundle rule"
    },
    {
      "type": "paragraph",
      "content": "The bundle product is added automatically whenever a shopper adds a variant matching both trigger values below."
    },
    {
      "type": "product",
      "id": "bundle_product",
      "label": "Bundle product"
    },
    {
      "type": "text",
      "id": "bundle_trigger_value_1",
      "label": "Trigger option value 1",
      "default": "Black"
    },
    {
      "type": "text",
      "id": "bundle_trigger_value_2",
      "label": "Trigger option value 2",
      "default": "Medium"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image override",
          "info": "Defaults to the product's featured image."
        },
        {
          "type": "range",
          "id": "hotspot_x",
          "label": "Hotspot horizontal position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 60
        },
        {
          "type": "range",
          "id": "hotspot_y",
          "label": "Hotspot vertical position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Gift guide grid",
      "blocks": [
        { "type": "product", "settings": { "hotspot_x": 59, "hotspot_y": 54 } },
        { "type": "product", "settings": { "hotspot_x": 82, "hotspot_y": 50 } },
        { "type": "product", "settings": { "hotspot_x": 60, "hotspot_y": 18 } },
        { "type": "product", "settings": { "hotspot_x": 70, "hotspot_y": 16 } },
        { "type": "product", "settings": { "hotspot_x": 49, "hotspot_y": 23 } },
        { "type": "product", "settings": { "hotspot_x": 74, "hotspot_y": 37 } }
      ]
    }
  ]
}
{% endschema %}
